{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认安全权限：仅允许向后端 API 域名发起 HTTP 请求",
  "windows": ["main"],
  "permissions": [
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:app:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        {
          "url": "http://39.106.162.26/*"
        }
      ]
    }
  ]
}
